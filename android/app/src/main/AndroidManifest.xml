<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Minimum permissions only. Each is requested at point-of-use. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Allows the optional user-configured local backend (e.g. a PC on the
         same Wi-Fi running the CyberShield backend + Ollama). The default
         cloud backend is always HTTPS; this only affects user-entered
         http:// addresses on trusted networks. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Camera is optional (QR scanning is opt-in) -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
      Package visibility (Android 11+): the broad QUERY_ALL_PACKAGES permission
      was REMOVED (sensitive/Play-restricted; enumerates every installed app).
      The App Security Scanner now sees the privacy-preserving subset Android
      allows without it: apps the user interacted with, apps with a launcher
      icon, and apps exposing the intents declared below. The scanner reports
      the partial coverage honestly in its UI instead of pretending a full
      inventory. Sideloaded user-installed apps (WhatsApp, Instagram, …) are
      still visible via the LAUNCHER/MAIN + interacted-apps filters.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="sms" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
    </queries>

    <application
        android:name=".CyberShieldApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.CyberShield">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.CyberShield">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Share Intent: receive text shared from other apps (messages/URLs) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Opt-in notification monitoring (user grants in Android Settings) -->
        <service
            android:name=".monitor.ShieldNotificationListener"
            android:exported="true"
            android:label="CyberShield notification monitoring"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
