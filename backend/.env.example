# CyberShield AI — Backend Environment Variables
# Copy to .env and adjust. Never commit real secrets.

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://cybershield:change-me@localhost:5432/cybershield

# Ollama local LLM runtime
OLLAMA_BASE_URL=http://localhost:11434
# Qwen-family model, pick one that fits your hardware:
#   qwen2.5:0.5b | qwen2.5:1.5b | qwen2.5:3b | qwen2.5:7b | qwen3:1.7b | qwen3:4b
OLLAMA_MODEL=qwen2.5:1.5b

# API server
API_HOST=0.0.0.0
API_PORT=8000

# ML model paths (create empty dirs; load with scripts/train_models.py)
MODEL_PATH=app/ml/roberta
URL_MODEL_PATH=app/ml/url_model
ANOMALY_MODEL_PATH=app/ml/anomaly_model

# Risk engine weights (must sum close to 1.0; auto-normalized anyway)
WEIGHT_NLP=0.30
WEIGHT_URL=0.30
WEIGHT_RULES=0.25
WEIGHT_FILE=0.15
WEIGHT_APP=0.10
WEIGHT_NETWORK=0.10
WEIGHT_CORRELATION=0.20

# Rate limiting
RATE_LIMIT_SCAN=30/minute
RATE_LIMIT_AI=10/minute

# Security
SECRET_KEY=change-me-in-production
CORS_ORIGINS=*

# AI explanation toggle
LLM_EXPLANATIONS_ENABLED=true
LLM_TIMEOUT_SECONDS=25
